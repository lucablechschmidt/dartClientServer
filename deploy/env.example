# Place on the Pi as ~/darts/.env (not into the repo).
IMAGE_TAG=latest
# First admin: created at startup as long as there is no admin in the DB yet (M3).
ADMIN_USER=darts
# Generate the line: node scripts/hash-password.mjs (second output; $ is escaped as $$ there because Compose interpolates .env)
ADMIN_PASSWORD_HASH=$$2a$$14$$...
# Public URL for invite links and QR codes
APP_URL=https://dartserver.swallow-pythagorean.ts.net
