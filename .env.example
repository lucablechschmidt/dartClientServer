# Local development: copy to .env (not into the repo). On the Pi, deploy/env.example applies.

# Path to the SQLite file. In the container: /data/darts.db (volume). Locally: ./data/darts.db
DATABASE_PATH=./data/darts.db

# First admin (M3): created at startup as long as there is no admin in the DB.
# Without these two lines the app starts with a warning, but nobody can log in.
# Next reads .env with variable expansion: every $ in the hash must be written as \$, otherwise the
# value becomes empty and startup aborts with "bcrypt hash expected". Generate the finished line with:
#   node scripts/hash-password.mjs 'admin-secret'     (also prints the $$ form for the Pi)
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=\$2b\$12\$paste-the-script-output-here

# Locally over http: cookie without the Secure flag, otherwise Safari does not set the session cookie (Chrome only on localhost).
COOKIE_SECURE=false

# Address in invite links and QR codes (locally the dev server)
APP_URL=http://localhost:3000
